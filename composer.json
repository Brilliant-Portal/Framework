{
    "name": "brilliant-portal/framework",
    "description": "BrilliantPortal is an opinionated Laravel preset.",
    "keywords": [
        "brilliant-portal",
        "laravel",
        "framework"
    ],
    "homepage": "https://github.com/Brilliant-Portal/Framework",
    "license": "MIT",
    "authors": [
        {
            "name": "LuminFire",
            "email": "help@luminfire.com"
        },
        {
            "name": "Andrew Minion",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^11.0",
        "laravel/framework": "^11.0",
        "laravel/jetstream": "^5.1",
        "laravel/telescope": "^5.1",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-robots-middleware": "^1.4",
        "tartanlegrand/laravel-openapi": "^1.13"
    },
    "require-dev": {
        "brianium/paratest": "^7.5",
        "larastan/larastan": "^2.9",
        "nunomaduro/collision": "^8.3",
        "orchestra/testbench": "^8.0 || ^9.2",
        "phpunit/phpunit": "^9.0 || ^10.0 || ^11.2"
    },
    "autoload": {
        "psr-4": {
            "BrilliantPortal\\Framework\\": "src",
            "BrilliantPortal\\Framework\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrilliantPortal\\Framework\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "./vendor/bin/testbench package:test --parallel --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "BrilliantPortal\\Framework\\FrameworkServiceProvider"
            ],
            "aliases": {
                "Framework": "BrilliantPortal\\Framework\\FrameworkFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
