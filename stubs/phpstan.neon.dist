includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app
        - config
        - routes

    # The level 8 is the highest level
    level: 5

    ignoreErrors:
        - '#Unsafe usage of new static#'
        - '#Call to private method [a-zA-Z_]+\(\) of parent class .+#'

    excludePaths:
        - ./*/*/FileToBeExcluded.php
